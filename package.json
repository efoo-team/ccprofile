{
  "name": "@efoo/ccprofile",
  "version": "0.1.1",
  "description": "Per-directory Claude Code account routing via ANTHROPIC_AUTH_TOKEN, direnv, and macOS Keychain",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/efoo-team/ccprofile.git"
  },
  "homepage": "https://github.com/efoo-team/ccprofile#readme",
  "bugs": {
    "url": "https://github.com/efoo-team/ccprofile/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "account",
    "profile",
    "direnv",
    "keychain",
    "cli"
  ],
  "bin": {
    "ccprofile": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "semantic-release",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^22.10.0",
    "semantic-release": "^25.0.5",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
